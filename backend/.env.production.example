# ================================
# MindSphere Backend - Production Environment Variables
# ================================
# 
# IMPORTANT: Set these via Fly.io secrets, NOT in this file!
# Command: flyctl secrets set VARIABLE_NAME=value
#

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here

# MongoDB Configuration
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/mindsphere?retryWrites=true&w=majority

# Application Security
SECRET_KEY=your-super-secret-key-min-32-characters-long

# Application Settings
PROJECT_NAME=MindSphere API
API_V1_STR=/api/v1
DEBUG=False

# CORS Settings (add your frontend URLs, comma-separated)
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com

# Optional: Rate Limiting
# MAX_REQUESTS_PER_MINUTE=60

# Optional: Model Settings
# MODEL_NAME=gpt-4-turbo-preview
# EMBEDDING_MODEL=text-embedding-3-small

# ================================
# How to set these on Fly.io:
# ================================
# flyctl secrets set OPENAI_API_KEY=sk-...
# flyctl secrets set MONGODB_URL=mongodb+srv://...
# flyctl secrets set SECRET_KEY=your-secret-key
# flyctl secrets set ALLOWED_ORIGINS=https://yourdomain.com
